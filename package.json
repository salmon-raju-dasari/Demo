{
  "name": "supermarket",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.js",
  "scripts": {
    "lint": "eslint .",
    "preview": "vite preview",
    "dev": "concurrently -k -n VITE,ELECTRON \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "electron:build": "electron-builder --dir",
    "dist": "npm run build && npm run electron:build",
    "build:android": "npm run build && npx cap sync android",
    "open:android": "npx cap open android",
    "sync:android": "npx cap sync android"
  },
  "build": {
    "appId": "com.example.supermarket",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "dir"
      ]
    },
    "asar": false
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/status-bar": "^7.0.3",
    "@tailwindcss/vite": "^4.1.17",
    "axios": "^1.6.0",
    "chart.js": "^4.5.1",
    "primeflex": "^3.3.0",
    "primeicons": "^6.0.0",
    "primereact": "^10.9.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.5",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.1.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "vite": "^7.1.7",
    "wait-on": "^9.0.1"
  }
}
